MYSQL_DATABASE=jobdb
MYSQL_USER=jobapp
MYSQL_PASSWORD=jobapp-local-password
APP_KAFKA_CONCURRENCY=3
JOB_API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
